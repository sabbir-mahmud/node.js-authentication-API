NODE_ENV=development
PORT=5000

# MongoDB (must be a replica set / Atlas cluster in production)
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=Auth_Server

# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated allowlist (required in production)
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the app (rate limiting keys on the real IP)
TRUST_PROXY=1

# Password reset: frontend page that receives ?token=...
PASSWORD_RESET_URL=http://localhost:3000/reset-password
RESET_TOKEN_TTL_MINUTES=30

# SMTP (forgot-password returns 503 when unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# debug | info | warn | error | silent
LOG_LEVEL=info
